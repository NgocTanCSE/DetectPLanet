# AgriScan AI — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env files.
# This file documents every env var used across all tiers.

# ─────────────────────────────────────────────────────────────────────────
# 1. POSTGRESQL DATABASE (required — API returns 503 when DB is unavailable)
# ─────────────────────────────────────────────────────────────────────────
DB_DRIVER=pgsql              # pgsql or mysql
DB_HOST=postgres             # In docker-compose: service name "postgres"
DB_PORT=5432                 # PostgreSQL default
DB_NAME=agriscan             # Database name (from docker-compose)
DB_USER=postgres             # Database user
DB_PASS=postgres             # Database password — CHANGE IN PRODUCTION

# ─────────────────────────────────────────────────────────────────────────
# 2. CLOUDFLARE WORKERS AI (called DIRECTLY from PHP via REST API)
# ─────────────────────────────────────────────────────────────────────────
# PHP posts to: https://api.cloudflare.com/client/v4/accounts/{ID}/ai/run/{model}
# Token needs: Account → Workers AI (Edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Model names (Workers AI model IDs)
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Model dự phòng khi model chính không khả dụng (vd. model trả phí)
CLOUDFLARE_VISION_FALLBACK=@cf/meta/llama-4-scout-17b-16e-instruct
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ── Optional legacy overrides ────────────────────────────────────────
# If you deploy the worker in workers/ai-worker instead of direct REST calls,
# set full URLs here and PHP will use them:
#   AI_ENDPOINT=https://agriscan-ai.workers.dev/predict
#   CHAT_ENDPOINT=https://agriscan-ai.workers.dev/chat
AI_ENDPOINT=
CHAT_ENDPOINT=
AI_TIMEOUT=90
# Production mode — real AI only, no mock fallback. When AI is unreachable the
# API returns an honest 503 so the UI shows an error state.
AGRISCAN_DEMO=0

# ─────────────────────────────────────────────────────────────────────────
# 3. REACT NATIVE APP CONFIG (consumed by react-native-config)
# ─────────────────────────────────────────────────────────────────────────
# These are read at build time by react-native-config (dotenv.gradle) and
# embedded into the native APK / web bundle.  Update .env (gitignored) for
# local dev values; keep .env.example in sync when adding new vars.
#
# The PHP API is served at the ROOT of port 887 — NO "/detectplanet_api" prefix:
#   - Android emulator:  http://10.0.2.2:887
#   - Web (browser):     http://localhost:887
#   - Real phone (same WiFi): http://<your-laptop-LAN-IP>:887
#       (find it with `hostname -I` on Linux; localhost and 10.0.2.2 are NOT
#        reachable from a physical phone, so use the LAN IP on-device.)
# For production: https://your-domain.com (or your deployed worker URL).
# Also set GOOGLE_CLIENT_ID to match the value in app.json → metadata.googleClientId
# (used by react-native-config at build time, NOT expo.extra).
API_URL=http://10.0.2.2:887
ALLOW_GUEST=false   # 'true' = bỏ qua màn đăng nhập (chỉ demo offline)
REQUIRE_AUTH=true   # Set 'true' to require Google OAuth login. When true,
                    # the backend ALSO enforces auth — unauthenticated requests
                    # to protected endpoints return HTTP 401.
IMAGE_PICKER_QUALITY=0.8
IMAGE_PICKER_BASE64=true

# ─────────────────────────────────────────────────────────────────────────
# 4. NGINX REVERSE PROXY (optional for production)
# ─────────────────────────────────────────────────────────────────────────
NGINX_HOST=agriscan.ai          # Domain name (CNAME must point to your server)
SSL_EMAIL=admin@agriscan.ai     # Email for Let's Encrypt certificate generation

# ─────────────────────────────────────────────────────────────────────────
# 5. GOOGLE OAUTH (Authentication)
# ─────────────────────────────────────────────────────────────────────────
# Get these from Google Cloud Console → APIs & Services → Credentials
#   Application type: "Web application" (has a client secret)
#   Authorized redirect URIs (thêm đúng URL API sẽ gọi):
#       http://10.0.2.2:887/auth/google/callback   (emulator Android)
#       http://localhost:887/auth/google/callback  (máy thật qua adb reverse)
#       https://your-domain.com/auth/google/callback (production)
#   Lưu ý: KHÔNG dùng custom scheme com.agriscan.ai://auth cho client loại
#   "Web application" — Google sẽ báo redirect_uri_mismatch. App mở
#   <API>/auth/google/start, backend đổi code rồi deep-link về app.
#
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Để trống = API tự suy ra http(s)://<host>/auth/google/callback (URL này phải được
# đăng ký trong Google Cloud Console → Credentials → OAuth client → Authorized redirect URIs).
GOOGLE_REDIRECT_URI=

# ─────────────────────────────────────────────────────────────────────────
# 6. CORS — Allowed origins for frontend requests
# ─────────────────────────────────────────────────────────────────────────
# Set this to your frontend ORIGIN(s). Required for browser CORS.
# Custom domain:  ALLOWED_ORIGINS=https://your-domain.com
# HF Spaces:      ALLOWED_ORIGINS=https://yourname-agriscan.hf.space
# Local web dev (React Native web on host):  http://localhost:8081
# Real phone web (React Native web on LAN): http://<your-laptop-LAN-IP>:8081
# (Native Android apps are NOT affected by CORS — they use 10.0.2.2.)
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:887,http://127.0.0.1:887,http://10.0.2.2:887

# ─────────────────────────────────────────────────────────────────────────
# 7. Cảnh báo dịch bệnh theo khu vực (GĐ2+)
# ─────────────────────────────────────────────────────────────────────────
# Bật/tắt cảnh báo nguy cơ theo thời tiết (0 = tắt hoàn toàn).
WEATHER_ENABLED=1
OPEN_METEO_BASE=https://api.open-meteo.com/v1/forecast
# Ngưỡng điểm rủi ro tối thiểu để tạo cảnh báo (0-100). 40=warning, 60=danger.
RISK_THRESHOLD=40
# Token để trigger job qua POST /jobs/run (header X-Job-Token). Rỗng = tắt route.
JOB_SECRET=CHANGE_ME_RANDOM_HEX
# GĐ3 — nhập tin chính thức từ Cục Trồng trọt & BVTV (bật sau khi crawler ổn định).
OFFICIAL_ENABLED=0
AUTO_APPROVE_OFFICIAL=false
# Số người khác nhau tối thiểu để gom thành cảnh báo cộng đồng
COMMUNITY_MIN_USERS=3
# Token duyệt tin/báo cáo qua /admin/* (header X-Admin-Token). Rỗng = tắt route.
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
