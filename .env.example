# AgriScan AI — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env files.
# This file documents every env var used across all tiers.

# ─────────────────────────────────────────────────────────────────────────
# 1. POSTGRESQL DATABASE (optional — API runs in mock mode without DB)
# ─────────────────────────────────────────────────────────────────────────
DB_DRIVER=pgsql              # pgsql or mysql
DB_HOST=postgres             # In docker-compose: service name "postgres"
DB_PORT=5432                 # PostgreSQL default
DB_NAME=agriscan             # Database name (from docker-compose)
DB_USER=postgres             # Database user
DB_PASS=postgres             # Database password — CHANGE IN PRODUCTION

# ─────────────────────────────────────────────────────────────────────────
# 2. CLOUDFLARE WORKERS AI (replaces local FastAPI + PyTorch)
# ─────────────────────────────────────────────────────────────────────────
# AI inference runs as a Cloudflare Worker. The PHP API proxies to it.
#
# Get these from Cloudflare Dashboard → Workers & Pages:
#   CLOUDFLARE_ACCOUNT_ID — your Cloudflare account ID
#   CLOUDFLARE_API_TOKEN  — API token with "Account Workers AI" + "Deploy"
#
# Deploy the worker:
#   cd workers/ai-worker && npm install && npx wrangler deploy --env production
#
# After deploy, wrangler will print your worker URL, e.g.:
#   https://agriscan-ai.your-subdomain.workers.dev
# Set AI_ENDPOINT and CHAT_ENDPOINT to that URL + /predict and /chat.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.2-11b-vision-instruct   # Vision model for plant disease diagnosis
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8 # Text model for AI chat

# Worker endpoints (set after wrangler deploy — FILL IN WITH YOUR DEPLOYED URL).
# If left blank, docker-compose falls back to the agriscan-ai.workers.dev URLs.
AI_ENDPOINT=
CHAT_ENDPOINT=
AI_TIMEOUT=60                  # Seconds — Cloudflare Workers AI is fast

# Demo fallback (default: 1 = ON). When the Workers AI worker is NOT deployed,
# /analyze returns a sample diagnosis and /chat returns a sample reply, both
# flagged `"is_mock": true` in the JSON, so the app is fully usable on a phone.
# Deploy the worker (see CLOUDFLARE_* above) and/or set AGRISCAN_DEMO=0 to use
# real inference and disable the sample fallback.
AGRISCAN_DEMO=1

# ─────────────────────────────────────────────────────────────────────────
# 3. EXPO / FRONTEND (app.json "extra" block)
# ─────────────────────────────────────────────────────────────────────────
# Update app.json → expo.extra.apiUrl to point your Expo app at your backend.
# The PHP API is served at the ROOT of port 887 — NO "/detectplanet_api" prefix:
#   - Android emulator:  http://10.0.2.2:887
#   - iOS simulator / web on host: http://localhost:887
#   - Real phone on the same WiFi: http://<your-laptop-LAN-IP>:887
#       (find it with `hostname -I` on Linux; localhost and 10.0.2.2 are NOT
#        reachable from a physical phone, so use the LAN IP on-device.)
# For production: https://your-domain.com (or your deployed worker URL).
# Also set app.json → expo.extra.googleClientId to match GOOGLE_CLIENT_ID.

# ─────────────────────────────────────────────────────────────────────────
# 4. NGINX REVERSE PROXY (optional for production)
# ─────────────────────────────────────────────────────────────────────────
NGINX_HOST=agriscan.ai          # Domain name (CNAME must point to your server)
SSL_EMAIL=admin@agriscan.ai     # Email for Let's Encrypt certificate generation

# ─────────────────────────────────────────────────────────────────────────
# 5. GOOGLE OAUTH (Authentication)
# ─────────────────────────────────────────────────────────────────────────
# Get these from Google Cloud Console → APIs & Services → Credentials
#   - Application type: "Web application" or "Android" / "iOS"
#   - Authorized redirect URIs:
#       com.agriscan.ai://auth     (custom scheme — cho mobile app, KHÔNG cần domain)
#       https://your-domain.com/auth/callback  (nếu có domain riêng)
#
#   Mobile app:  chỉ cần GOOGLE_CLIENT_ID (safe để để trong app)
#                GOOGLE_CLIENT_SECRET chỉ cần trên backend (PHP API)
#   No domain?   Dùng custom scheme com.agriscan.ai://auth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=                  # Leave blank for mobile (uses com.agriscan.ai://auth)

# ─────────────────────────────────────────────────────────────────────────
# 6. CORS — Allowed origins for frontend requests
# ─────────────────────────────────────────────────────────────────────────
# Set this to your Expo/web frontend ORIGIN(s). Required for browser CORS.
# Custom domain:  ALLOWED_ORIGINS=https://your-domain.com
# HF Spaces:      ALLOWED_ORIGINS=https://yourname-agriscan.hf.space
# Local web dev (Expo web on host):  http://localhost:8081
# Real phone web (Expo web on LAN): http://<your-laptop-LAN-IP>:8081
# (Native apps run via Expo Go are NOT affected by CORS.)
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:887,http://127.0.0.1:887,http://10.0.2.2:887
