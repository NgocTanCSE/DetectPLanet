{
  "name": "com.agriscan.ai",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "android:release": "cd android && ./gradlew assembleRelease",
    "emu": "emulator -avd dtct -no-audio -no-boot-anim",
    "up": "./up.sh",
    "up:build": "./up.sh build",
    "up:logs": "./up.sh --logs",
    "up:serverless": "./up.sh serverless",
    "down": "docker compose down -v",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps",
    "db:psql": "docker exec -it agriscan-postgres psql -U postgres -d agriscan",
    "ai:dev": "cd workers/ai-worker && npm run dev",
    "ai:deploy": "cd workers/ai-worker && npm run deploy:prod",
    "ai:health": "curl -s $AI_ENDPOINT/health 2>/dev/null || echo 'Worker not deployed yet'"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-image-picker": "^8.3.1",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-config": "^1.7.2",
    "react-native-device-info": "^11.1.0"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
