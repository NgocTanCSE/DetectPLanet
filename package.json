{
  "name": "myapp",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "emu": "emulator -avd dtct -no-audio -no-boot-anim",
    "validate": "node _validate.js",
    "up": "./up.sh",
    "up:build": "./up.sh build",
    "up:logs": "./up.sh --logs",
    "up:serverless": "./up.sh serverless",
    "down": "docker compose down -v",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps",
    "db:psql": "docker exec -it agriscan-postgres psql -U postgres -d agriscan",
    "ai:dev": "cd workers/ai-worker && npm run dev",
    "ai:deploy": "cd workers/ai-worker && npm run deploy:prod",
    "ai:health": "curl -s $AI_ENDPOINT/health 2>/dev/null || echo 'Worker not deployed yet'"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "~0.4.0",
    "@expo-google-fonts/plus-jakarta-sans": "~0.4.0",
    "@expo-google-fonts/space-grotesk": "~0.4.0",
    "@expo/vector-icons": "^15.0.3",
    "expo": "^57.0.29",
    "expo-camera": "^57.0.6",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.2.4",
    "playwright": "^1.64.0",
    "typescript": "~6.0.3"
  }
}
