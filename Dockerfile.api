# ─────────────────────────────────────────────────────────────────────────
# AgriScan AI — PHP API Dockerfile
# Multi-stage build: PHP 8.2 with Apache + required extensions
# ─────────────────────────────────────────────────────────────────────────
FROM php:8.2-apache

# Install system + PHP extensions needed by AgriScan
#   pdo, pdo_pgsql, pdo_mysql  — database access
#   mbstring                   — UTF-8 string handling
#   gd                         — image processing (future enhancement)
#   zip                        — archive handling (future enhancement)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpng-dev \
    libzip-dev \
    libonig-dev \
    libpq-dev \
    unzip \
    curl \
    && docker-php-ext-install \
    pdo \
    pdo_pgsql \
    pdo_mysql \
    mbstring \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Enable Apache mod_rewrite for clean URLs + AllowOverride so .htaccess works
RUN a2enmod rewrite \
    && sed -i 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf

# Create uploads directory with correct permissions
RUN mkdir -p /var/www/html/uploads && chown -R www-data:www-data /var/www/html/uploads

# Copy API source files
COPY api/index.php /var/www/html/index.php
COPY api/config.php /var/www/html/config.php
COPY api/.htaccess /var/www/html/.htaccess
COPY api/routes /var/www/html/routes
COPY api/controllers /var/www/html/controllers
COPY api/middleware /var/www/html/middleware
COPY api/services /var/www/html/services
COPY api/uploads/ /var/www/html/uploads/

# Set proper permissions on code
RUN chown -R www-data:www-data /var/www/html/*.php

# AI endpoint is empty by default — PHP calls Cloudflare Workers AI directly.
# If a legacy self-hosted AI worker is used, set AI_ENDPOINT via environment.
ARG AI_ENDPOINT=""
ENV AI_ENDPOINT ${AI_ENDPOINT}

EXPOSE 80

# Health check — verify Apache + PHP respond AND the API router answers
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl --fail --silent --max-time 5 "http://127.0.0.1:${PORT:-80}/health" > /dev/null || exit 1

# Support dynamic PORT injection from Render/Railway/Fly
CMD ["sh", "-c", "sed -i \"s/80/${PORT:-80}/g\" /etc/apache2/ports.conf /etc/apache2/sites-available/000-default.conf && exec apache2-foreground"]

