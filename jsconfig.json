{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "skipLibCheck": true,
    "checkJs": false,
    "maxNodeModuleJsDepth": 0,
    "moduleResolution": "node"
  },
  "include": [
    "index.js",
    "frontend/App.js",
    "frontend/utils/theme.js",
    "frontend/hooks/useFonts.js",
    "frontend/icons.js",
    "frontend/components/layout/AppHeader.js",
    "frontend/components/layout/BottomNav.js",
    "frontend/components/layout/ProgressCircle.js",
    "frontend/services/auth.js",
    "frontend/screens/LoginScreen.js",
    "frontend/utils/dto.js",
    "frontend/services/api.js",
    "frontend/services/storage.js",
    "frontend/components/Button.js",
    "frontend/components/Card.js",
    "frontend/components/Input.js",
    "frontend/components/Avatar.js",
    "frontend/components/Badge.js",
    "frontend/components/Pill.js",
    "frontend/components/SectionHeader.js",
    "frontend/components/EmptyState.js",
    "frontend/components/ProgressStep.js",
    "frontend/components/index.js",
    "frontend/screens/HomeScreen.js",
    "frontend/screens/ScanScreen.js",
    "frontend/screens/CameraScreen.js",
    "frontend/screens/ResultScreen.js",
    "frontend/screens/HistoryScreen.js",
    "frontend/screens/ChatScreen.js",
    "frontend/screens/GuidesScreen.js",
    "frontend/screens/SettingsScreen.js"
  ],
  "exclude": [
    "node_modules",
    "android",
    "web-build",
    "TempAgriScan"
  ]
}
